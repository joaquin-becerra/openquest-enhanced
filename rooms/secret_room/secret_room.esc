:setup
	play_snd("res://music/secret_room.ogg", "_music")
	if ensign_zob_room == "SecretRoom":
		set_active("player", true)
	else:
		set_active("player", false)
	if bluecup_actor_room == "SecretRoom":
		set_active("bluecup_actor", true)
	else:
		set_active("bluecup_actor", false)
	if cube_actor_room == "SecretRoom":
		set_active("cube_actor", true)
	else:
		set_active("cube_actor", false)
	if commander_zif_room == "SecretRoom":
		set_active("commander_zif", true)
	else:
		set_active("commander_zif", false)
	scumm_restore_names()
	scumm_roam("", "setup")
	scumm_fade_in()

:ready
	# test shortcut (start_game.esc): straight to handing over the gun
	if debug_saltar_al_final == 1:
		debug_saltar_al_final = 0
		# teleport_pos doesn't recompute the draw order (z): a short walk does
		teleport_pos("player", 600, 480)
		teleport_pos("commander_zif", 380, 460)
		walk_to_pos("commander_zif", 400, 460)
		walk_to_pos_block("player", 620, 480)
		debug_final()
		stop
	ensign_zob_room = "SecretRoom"
	set_active("player", true)
	teleport_pos("player", 160, 400)
	walk_to_pos("player", 368, 400)
