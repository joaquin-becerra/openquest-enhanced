:init
	global asked_passageway = 0
	global bluecup_actor_room = "SecretRoom"
	global bullets_state = 1
	global cabinet_drawer_state = 0
	global carol_room = ""
	global carol_state = 0
	global commander_zif_room = ""
	global commander_zif_state = 0
	global cube_actor_room = "SecretRoom"
	global cube_disappeared = 0
	global did_office_intro = 0
	global ensign_zob_room = ""
	global exit_to_secret_room_state = 1
	global has_pressed_plate = 0
	global has_seen_bullets = 0
	global has_shot_at_node = 0
	global has_smelled_plate = 0
	global has_talked_about_plant = 0
	global has_talked_about_plate = 0
	global has_tried_to_move_plant = 0
	global inited_game = 0
	global inv_gun_state = 0
	global inv_scanner_state = 1
	global knows_carol = 0
	global light_switch_state = 0
	global plant_state = 1
	global player_state = 0
	global terminal_activated = 0
	global ufo_actor_room = ""
	global credits_start = 0
	# TEST SHORTCUT: at 1 the game starts in the secret room right when Zob gives
	# the gun to Zif (the end). Set it to 0 to play normally.
	global debug_saltar_al_final = 0
	if debug_saltar_al_final == 1:
		did_office_intro = 1
		inited_game = 1
		ensign_zob_room = "SecretRoom"
		commander_zif_room = "SecretRoom"
		cube_actor_room = "InventoryItems"
		cube_disappeared = 1
		terminal_activated = 1
		inv_gun_state = 2
		has_shot_at_node = 1
		inventory_add("inv_scanner")
		inventory_add("inv_gun")
		change_scene("res://rooms/secret_room/secret_room.tscn")
		stop
	scumm_screen_effect(5)
	scumm_fade_out(true)
	change_scene("res://rooms/title_screen/title_screen.tscn")
	inventory_add("inv_scanner")

:newgame
	global asked_passageway = 0
	global bluecup_actor_room = "SecretRoom"
	global bullets_state = 1
	global cabinet_drawer_state = 0
	global carol_room = ""
	global carol_state = 0
	global commander_zif_room = ""
	global commander_zif_state = 0
	global cube_actor_room = "SecretRoom"
	global cube_disappeared = 0
	global did_office_intro = 0
	global ensign_zob_room = ""
	global exit_to_secret_room_state = 1
	global has_pressed_plate = 0
	global has_seen_bullets = 0
	global has_shot_at_node = 0
	global has_smelled_plate = 0
	global has_talked_about_plant = 0
	global has_talked_about_plate = 0
	global has_tried_to_move_plant = 0
	global inited_game = 0
	global inv_gun_state = 0
	global inv_scanner_state = 1
	global knows_carol = 0
	global light_switch_state = 0
	global plant_state = 1
	global player_state = 0
	global terminal_activated = 0
	global ufo_actor_room = ""
	global credits_start = 0
	global debug_saltar_al_final = 0
	scumm_screen_effect(5)
	scumm_fade_out(true)
	change_scene("res://rooms/title_screen/title_screen.tscn")
	inventory_add("inv_scanner")
