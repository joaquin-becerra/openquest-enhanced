extends "res://addons/escoria-dialog-simple/types/floating.gd"
# Generated by scumm2escoria: speech the way SCUMM v6 shows it.
# - the whole line at once (no typing effect),
# - centered on the actor's talk position, wrapped so it stays on screen
#   (line width at most 2 * min(x, screen width - x)),
# - shown for (characters * VAR_CHARINC) game frames.

const SCREEN_WIDTH := 1280
const CHAR_INC := 4
const GAME_FPS := 30.0


func _ready():
	super()
	fit_content = true
	autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	scroll_active = false
	mouse_filter = Control.MOUSE_FILTER_IGNORE


func say(character: String, line: String):
	super(character, line)
	_scumm_layout()


func _scumm_layout() -> void:
	if not is_instance_valid(dialog_location_node):
		return
	var x: float = dialog_location_node.get_global_transform_with_canvas().origin.x
	var max_width: float = 2.0 * clampf(minf(x, SCREEN_WIDTH - x), 1.0, SCREEN_WIDTH / 2.0)
	var font := get_theme_font("normal_font")
	var font_size := get_theme_font_size("normal_font_size")
	var width := font.get_string_size(get_parsed_text(), HORIZONTAL_ALIGNMENT_LEFT, -1, font_size).x
	size = Vector2(minf(width + 2, max_width), 0)
	position.x = x - size.x / 2


func _calculate_time_to_disappear() -> float:
	return len(_current_line) * CHAR_INC / GAME_FPS


# Talk animation while the text is on screen. Escoria stops it
# when the text finishes typing (it appears at once) or when the
# audio ends (there are no voices), so it lasted zero frames: restart it and
# stop it only when the line disappears.
func _on_dialog_line_typed(_object, _key):
	# with voice audio Escoria doesn't stop it (it runs until the audio ends)
	var cut := _should_stop_talking_when_text_finishes()
	super(_object, _key)
	if cut and is_instance_valid(_current_character):
		_current_character.start_talking()


func _on_dialog_finished():
	_stop_character_talking()
	super()
