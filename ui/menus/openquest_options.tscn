[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/openquest_options.gd" id="script"]
[ext_resource type="Texture2D" path="res://ui/menus/menu_button.png" id="button"]
[ext_resource type="FontFile" path="res://fonts/verb_chset.fnt" id="font"]

[sub_resource type="StyleBoxTexture" id="box"]
texture = ExtResource("button")
texture_margin_left = 10.0
texture_margin_top = 10.0
texture_margin_right = 10.0
texture_margin_bottom = 10.0
content_margin_left = 16.0
content_margin_right = 16.0

[sub_resource type="StyleBoxTexture" id="box_hover"]
texture = ExtResource("button")
texture_margin_left = 10.0
texture_margin_top = 10.0
texture_margin_right = 10.0
texture_margin_bottom = 10.0
content_margin_left = 16.0
content_margin_right = 16.0
modulate_color = Color(1.15, 1.15, 1.15, 1)

[sub_resource type="StyleBoxEmpty" id="empty"]

[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.188, 0.545, 0.812, 0.92)
border_width_left = 4
border_width_top = 4
border_width_right = 4
border_width_bottom = 4
border_color = Color(0.129, 0.384, 0.573, 1)
content_margin_left = 40.0
content_margin_top = 24.0
content_margin_right = 40.0
content_margin_bottom = 32.0

[sub_resource type="StyleBoxFlat" id="slider"]
bg_color = Color(0.129, 0.384, 0.573, 1)
content_margin_top = 6.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="slider_fill"]
bg_color = Color(0.8863, 0.8745, 0.8627, 1)
content_margin_top = 6.0
content_margin_bottom = 6.0

[node name="options" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("script")

[node name="panel" type="PanelContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -350.0
offset_top = -260.0
offset_right = 350.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("panel")

[node name="rows" type="VBoxContainer" parent="panel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="title" type="Label" parent="panel/rows"]
layout_mode = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_shadow_color = Color(0.094, 0.243, 0.408, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
text = "OPTIONS"
horizontal_alignment = 1

[node name="grid" type="GridContainer" parent="panel/rows"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 32
theme_override_constants/v_separation = 18
columns = 2

[node name="language_label" type="Label" parent="panel/rows/grid"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_shadow_color = Color(0.094, 0.243, 0.408, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
text = "OPTIONS_LANGUAGE"
vertical_alignment = 1

[node name="language" type="OptionButton" parent="panel/rows/grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(380, 64)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_focus_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_hover_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_pressed_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_hover_pressed_color = Color(0, 0.251, 0.502, 1)
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("box")
theme_override_styles/hover = SubResource("box_hover")
theme_override_styles/pressed = SubResource("box_hover")
theme_override_styles/hover_pressed = SubResource("box_hover")
theme_override_styles/focus = SubResource("empty")
alignment = 1

[node name="music_label" type="Label" parent="panel/rows/grid"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_shadow_color = Color(0.094, 0.243, 0.408, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
text = "MUSIC_VOLUME"
vertical_alignment = 1

[node name="music" type="HSlider" parent="panel/rows/grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(380, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
theme_override_styles/slider = SubResource("slider")
theme_override_styles/grabber_area = SubResource("slider_fill")
theme_override_styles/grabber_area_highlight = SubResource("slider_fill")
max_value = 1.0
step = 0.05

[node name="effects_label" type="Label" parent="panel/rows/grid"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_shadow_color = Color(0.094, 0.243, 0.408, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
text = "EFFECTS_VOLUME"
vertical_alignment = 1

[node name="effects" type="HSlider" parent="panel/rows/grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(380, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
theme_override_styles/slider = SubResource("slider")
theme_override_styles/grabber_area = SubResource("slider_fill")
theme_override_styles/grabber_area_highlight = SubResource("slider_fill")
max_value = 1.0
step = 0.05

[node name="graphics_label" type="Label" parent="panel/rows/grid"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_shadow_color = Color(0.094, 0.243, 0.408, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
text = "GRAPHICS"
vertical_alignment = 1

[node name="graphics" type="OptionButton" parent="panel/rows/grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(380, 64)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_focus_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_hover_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_pressed_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_hover_pressed_color = Color(0, 0.251, 0.502, 1)
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
theme_override_styles/normal = SubResource("box")
theme_override_styles/hover = SubResource("box_hover")
theme_override_styles/pressed = SubResource("box_hover")
theme_override_styles/hover_pressed = SubResource("box_hover")
theme_override_styles/focus = SubResource("empty")
alignment = 1

[node name="screen_label" type="Label" parent="panel/rows/grid"]
custom_minimum_size = Vector2(240, 64)
layout_mode = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_shadow_color = Color(0.094, 0.243, 0.408, 1)
theme_override_constants/shadow_offset_x = 3
theme_override_constants/shadow_offset_y = 3
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
text = "SCREEN"
vertical_alignment = 1

[node name="screen" type="OptionButton" parent="panel/rows/grid"]
unique_name_in_owner = true
custom_minimum_size = Vector2(380, 64)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_focus_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_hover_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_pressed_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_hover_pressed_color = Color(0, 0.251, 0.502, 1)
theme_override_fonts/font = ExtResource("font")
theme_override_font_sizes/font_size = 40
