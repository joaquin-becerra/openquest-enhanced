theme_override_styles/pressed = SubResource("box_hover")
theme_override_styles/hover_pressed = SubResource("box_hover")
theme_override_styles/focus = SubResource("empty")
text = "OPTIONS_BACK"

[connection signal="item_selected" from="panel/rows/grid/language" to="." method="_on_language_selected"]
[connection signal="value_changed" from="panel/rows/grid/music" to="." method="_on_music_changed"]
[connection signal="value_changed" from="panel/rows/grid/effects" to="." method="_on_effects_changed"]
[connection signal="item_selected" from="panel/rows/grid/graphics" to="." method="_on_graphics_selected"]
[connection signal="item_selected" from="panel/rows/grid/screen" to="." method="_on_screen_selected"]
[connection signal="pressed" from="panel/rows/back" to="." method="_on_back_pressed"]
