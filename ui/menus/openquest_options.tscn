theme_override_styles/hover_pressed = SubResource("box_hover")
theme_override_styles/focus = SubResource("empty")
alignment = 1

[node name="back" type="Button" parent="panel/rows"]
custom_minimum_size = Vector2(300, 72)
layout_mode = 2
size_flags_horizontal = 4
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_focus_color = Color(0.8863, 0.8745, 0.8627, 1)
theme_override_colors/font_hover_color = Color(0, 0.251, 0.502, 1)
theme_override_colors/font_pressed_color = Color(0, 0.251, 0.502, 1)
